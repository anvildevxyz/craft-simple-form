{
  "name": "fabianhaef/craft-simple-form",
  "description": "A lightweight, translatable form builder for Craft CMS",
  "type": "craft-plugin",
  "license": "proprietary",
  "keywords": ["craft", "cms", "craftcms", "forms", "form-builder", "translatable"],
  "support": {
    "issues": "https://github.com/fabianhaef/craft-simple-form/issues",
    "source": "https://github.com/fabianhaef/craft-simple-form"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "craftcms/phpstan": "dev-main",
    "craftcms/ecs": "dev-main",
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.0",
    "codeception/module-yii2": "^1.1",
    "dompdf/dompdf": "^2.0 || ^3.0"
  },
  "suggest": {
    "stimmt/craft-mcp": "Exposes Simple Form's read-only integration tools (plus form/submission tools) over the Model Context Protocol so AI agents can introspect forms and integration dispatch health.",
    "craftcms/commerce": "Enables the Payment field — collect a payment on submit via a Commerce order; notifications/integrations are held until the order is paid.",
    "dompdf/dompdf": "Enables submission PDF generation — attach a print-ready PDF of a submission to notification emails and download it from the CP submission detail."
  },
  "autoload": {
    "psr-4": {
      "fabianhaef\\simpleform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "fabianhaef\\simpleform\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Simple Form",
    "handle": "simple-form",
    "class": "fabianhaef\\simpleform\\Plugin",
    "developer": "Fabian Haefliger",
    "developerUrl": "https://github.com/fabianhaef",
    "documentationUrl": "https://github.com/fabianhaef/craft-simple-form/tree/main/docs",
    "changelogUrl": "https://raw.githubusercontent.com/fabianhaef/craft-simple-form/main/CHANGELOG.md"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "codecept run integration",
    "test:smoke": "codecept run smoke",
    "test:js": [
      "node tests/js/conditional-evaluator.test.js",
      "node tests/js/formula.test.js",
      "node tests/js/success-action.test.js",
      "node tests/js/row-grouping.test.js",
      "node tests/js/hook-events.test.js"
    ],
    "test:all": ["@test", "@test:js", "@test:integration", "@test:smoke"],
    "ecs": "ecs check",
    "ecs-fix": "ecs check --fix",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "check": ["@ecs", "@phpstan", "@test"]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
