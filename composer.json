{
  "name": "fabianhaef/craft-simple-form",
  "description": "A lightweight, translatable form builder for Craft CMS",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": ["craft", "cms", "craftcms", "forms", "form-builder", "translatable"],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "craftcms/phpstan": "dev-main",
    "craftcms/ecs": "dev-main",
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.0",
    "codeception/module-yii2": "^1.1"
  },
  "suggest": {
    "stimmt/craft-mcp": "Exposes Simple Form's read-only integration tools (plus form/submission tools) over the Model Context Protocol so AI agents can introspect forms and integration dispatch health."
  },
  "autoload": {
    "psr-4": {
      "fabianhaef\\simpleform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "fabianhaef\\simpleform\\tests\\": "tests/"
    }
  },
  "extra": {
    "handle": "simple-form",
    "class": "fabianhaef\\simpleform\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "codecept run integration",
    "test:js": "node tests/js/conditional-evaluator.test.js",
    "test:all": ["@test", "@test:js", "@test:integration"],
    "ecs": "ecs check",
    "ecs-fix": "ecs check --fix",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "check": ["@ecs", "@phpstan", "@test"]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
