{#
  Default Simple Form theme — error list (#137).

  Part of the partial contract so themes can override error presentation. The
  default front-end submit is JS-driven (errors are shown client-side), so this
  partial is a no-op unless a caller passes `errors`. It is provided as the
  documented seam for the no-JS POST round-trip and hand-authored layouts.

  Variables:
    errors   list<string> of messages (optional)
-#}
{%- apply spaceless -%}
{%- if errors is defined and errors|length -%}
<ul class="simple-form-errors" role="alert">
{%- for error in errors -%}
<li>{{ error }}</li>
{%- endfor -%}
</ul>
{%- endif -%}
{%- endapply -%}
