{% import "_includes/forms.twig" as forms %}

<h2>{{ 'Data Collection'|t('simple-form') }}</h2>

{{ forms.lightswitchField({
    label: 'Collect IP addresses'|t('simple-form'),
    instructions: 'Store the visitor’s IP address on each submission. Turn off for GDPR data minimization — rate limiting still works (nothing is stored), but IP-based duplicate detection is disabled.'|t('simple-form'),
    id: 'collectIpAddresses',
    name: 'collectIpAddresses',
    on: settings.collectIpAddresses,
}) }}

<h2>{{ 'Data Retention'|t('simple-form') }}</h2>
<p class="light">
    {{ 'Automatically prune old data on Craft’s garbage-collection run. Use 0 to keep data forever.'|t('simple-form') }}
</p>

{% include 'simple-form/settings/_pro-notice' with { feature: 'Automatic submission deletion and anonymization'|t('simple-form') } only %}

{{ forms.textField({
    label: 'Delete submissions after (days)'|t('simple-form'),
    instructions: 'Submissions older than this are removed during garbage collection. 0 = keep forever.'|t('simple-form'),
    id: 'retainSubmissionsDays',
    name: 'retainSubmissionsDays',
    type: 'number',
    min: 0,
    step: 1,
    size: 6,
    value: settings.retainSubmissionsDays,
}) }}

{{ forms.lightswitchField({
    label: 'Anonymize instead of delete'|t('simple-form'),
    instructions: 'When on, expired submissions keep their row (so counts/stats survive) but their submitted data and user reference are scrubbed.'|t('simple-form'),
    id: 'anonymizeInsteadOfDelete',
    name: 'anonymizeInsteadOfDelete',
    on: settings.anonymizeInsteadOfDelete,
    disabled: 'anonymizeInsteadOfDelete' in proLockedFields,
}) }}

{{ forms.textField({
    label: 'Delete integration logs after (days)'|t('simple-form'),
    instructions: 'Outbound-integration dispatch log rows older than this are pruned. 0 = keep forever.'|t('simple-form'),
    id: 'retainIntegrationLogsDays',
    name: 'retainIntegrationLogsDays',
    type: 'number',
    min: 0,
    step: 1,
    size: 6,
    value: settings.retainIntegrationLogsDays,
}) }}

{{ forms.textField({
    label: 'Delete notification logs after (days)'|t('simple-form'),
    instructions: 'Notification send-log rows older than this are pruned. 0 = keep forever.'|t('simple-form'),
    id: 'retainNotificationLogsDays',
    name: 'retainNotificationLogsDays',
    type: 'number',
    min: 0,
    step: 1,
    size: 6,
    value: settings.retainNotificationLogsDays,
}) }}

{{ forms.textField({
    label: 'Delete audit log after (days)'|t('simple-form'),
    instructions: 'Audit-trail rows older than this are pruned. 0 = keep forever.'|t('simple-form'),
    id: 'retainAuditLogDays',
    name: 'retainAuditLogDays',
    type: 'number',
    min: 0,
    step: 1,
    size: 6,
    value: settings.retainAuditLogDays,
}) }}

{{ forms.textField({
    label: 'Delete captured partials after (days)'|t('simple-form'),
    instructions: 'Abandoned partials (passive capture) older than this are removed during garbage collection. Kept deliberately short so abandoned data doesn’t linger.'|t('simple-form'),
    id: 'partialRetentionDays',
    name: 'partialRetentionDays',
    type: 'number',
    min: 1,
    step: 1,
    size: 6,
    value: settings.partialRetentionDays,
}) }}
