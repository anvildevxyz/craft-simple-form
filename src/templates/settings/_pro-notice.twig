{# ===========================================================================
   Pro-upsell notice — shown to Solo above a Pro-only settings area.
   Param: feature (human label of the gated feature).
   Pairs with the service-level inertness in P4: these settings save but have
   no effect on Solo.
   =========================================================================== #}
{% if not craft.simpleForm.isPro() %}
    <blockquote class="note">
        <strong>{{ 'Pro feature.'|t('simple-form') }}</strong>
        {{ '{feature} is part of the Pro edition — these settings have no effect on the Solo edition.'|t('simple-form', { feature: feature ?? 'This feature'|t('simple-form') }) }}
    </blockquote>
{% endif %}
