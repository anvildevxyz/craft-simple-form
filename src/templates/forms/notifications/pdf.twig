{# =============================================================================
 # Default submission PDF layout (#143).
 #
 # Rendered, sandboxed, by PdfService into a dompdf document. Copy this file into
 # your project's `templates/simple-form/forms/notifications/pdf.twig` to fully
 # override the layout. Available variables: `form`, `submission`, `data`
 # (the field rows, each { label, type, value }). It is rendered per the
 # notification's site, so it localises.
 # ========================================================================== #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 12px; color: #1f2933; }
        h1 { font-size: 18px; margin: 0 0 4px; }
        .meta { color: #616e7c; font-size: 11px; margin: 0 0 16px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e4e7eb; vertical-align: top; }
        th { width: 32%; font-weight: bold; }
        .empty { color: #9aa5b1; }
    </style>
</head>
<body>
    <h1>{{ form.title ?? form.name }}</h1>
    <p class="meta">
        {{ 'Submission #{id}'|t('simple-form', { id: submission.id }) }}
        &middot;
        {{ submission.dateCreated|date('Y-m-d H:i') }}
    </p>

    <table>
        {% for row in data %}
            <tr>
                <th>{{ row.label ?? '' }}</th>
                <td>
                    {%- set value = row.value ?? null -%}
                    {%- if value is empty -%}
                        <span class="empty">&mdash;</span>
                    {%- elseif value is iterable -%}
                        {{ value|join(', ') }}
                    {%- else -%}
                        {{ value }}
                    {%- endif -%}
                </td>
            </tr>
        {% endfor %}
    </table>
</body>
</html>
