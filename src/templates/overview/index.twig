{% extends '_layouts/cp.twig' %}

{% set title = 'Overview'|t('simple-form') %}
{% set selectedSubnavItem = 'overview' %}
{% do craft.app.view.registerAssetBundle('anvildev\\simpleform\\web\\assets\\cp\\SimpleFormCpAsset') %}

{% block actionButton %}
    {% if canManageForms %}
        <a class="btn submit add icon" href="{{ cpUrl('simple-form/forms/new') }}">{{ 'New Form'|t('simple-form') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {# Headline figures. #}
    <div class="submission-stats">
        {% set cards = [
            { label: 'Forms'|t('simple-form'), value: formCount },
            { label: 'Submissions'|t('simple-form'), value: stats.total },
            { label: 'Today'|t('simple-form'), value: today },
            { label: 'Last 7 days'|t('simple-form'), value: last7 },
            { label: 'Spam blocked'|t('simple-form'), value: stats.spam, key: 'spam' },
        ] %}
        {% for card in cards %}
            <div class="stat-card{{ (card.key ?? null) ? ' stat-' ~ card.key : '' }}">
                <span class="stat-value">{{ card.value }}</span>
                <span class="stat-label">{{ card.label }}</span>
            </div>
        {% endfor %}
    </div>

    {# Needs attention — only rendered when there's something to act on. #}
    {% set attention = [] %}
    {% if stats.new > 0 %}
        {% set attention = attention|merge([{
            label: '{n} new submission(s) to review'|t('simple-form', { n: stats.new }),
            url: cpUrl('simple-form/submissions', { status: 'new' }),
        }]) %}
    {% endif %}
    {% if failedDispatches > 0 %}
        {% set attention = attention|merge([{
            label: '{n} failed integration dispatch(es)'|t('simple-form', { n: failedDispatches }),
            url: cpUrl('simple-form/settings/integrations/failures'),
        }]) %}
    {% endif %}
    {% if attention|length %}
        <div class="sf-attention pane">
            <h2>{{ 'Needs attention'|t('simple-form') }}</h2>
            <ul>
                {% for item in attention %}
                    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if not hasAnySubmissions %}
        {# First-run: no submissions captured yet. #}
        <div class="zilch">
            <p>{{ 'No submissions yet.'|t('simple-form') }}</p>
            {% if canManageForms %}
                <p class="light">{{ 'Create a form and embed it on your site to start collecting submissions.'|t('simple-form') }}</p>
                <a class="btn submit" href="{{ cpUrl('simple-form/forms/new') }}">{{ 'New Form'|t('simple-form') }}</a>
            {% endif %}
        </div>
    {% else %}
        {# Submissions over time — lightweight CSS bar chart, matching Analytics. #}
        <h2>{{ 'Submissions over time'|t('simple-form') }}</h2>
        {% set maxCount = 1 %}
        {% for point in perDay %}{% set maxCount = max(maxCount, point.count) %}{% endfor %}
        <div class="sf-bar-chart" role="img"
             aria-label="{{ 'Submissions over the last {d} days'|t('simple-form', { d: chartDays }) }}">
            {% for point in perDay %}
                <div class="sf-bar-col" title="{{ point.date }}: {{ point.count }}">
                    <div class="sf-bar" style="height: {{ (point.count / maxCount * 100)|round }}%"></div>
                </div>
            {% endfor %}
        </div>
        <p class="light">
            <a href="{{ cpUrl('simple-form/submissions/analytics') }}">{{ 'View full analytics →'|t('simple-form') }}</a>
        </p>

        <div class="sf-overview-cols">
            {# Recent submissions. #}
            <div class="sf-overview-col">
                <h2>{{ 'Recent submissions'|t('simple-form') }}</h2>
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>{{ 'Form'|t('simple-form') }}</th>
                            <th>{{ 'Status'|t('simple-form') }}</th>
                            <th>{{ 'Date'|t('simple-form') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for submission in recent %}
                            {% set form = submission.getForm() %}
                            <tr>
                                <td>
                                    <a href="{{ cpUrl('simple-form/submissions/' ~ submission.id) }}">
                                        {{ form ? (form.title ?? form.name) : '#' ~ submission.formId }}
                                    </a>
                                </td>
                                <td><span class="status {{ submission.readStatus }}"></span>{{ submission.readStatus|t('simple-form')|title }}</td>
                                <td>{{ submission.dateCreated|datetime('short') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="light"><a href="{{ cpUrl('simple-form/submissions') }}">{{ 'All submissions →'|t('simple-form') }}</a></p>
            </div>

            {# Top forms by submission volume. #}
            <div class="sf-overview-col">
                <h2>{{ 'Top forms'|t('simple-form') }}</h2>
                {% if perForm|length %}
                    <table class="data fullwidth">
                        <thead>
                            <tr>
                                <th>{{ 'Form'|t('simple-form') }}</th>
                                <th>{{ 'Submissions'|t('simple-form') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in perForm %}
                                <tr>
                                    <td><a href="{{ cpUrl('simple-form/submissions', { formId: row.formId, status: 'all' }) }}">{{ row.name }}</a></td>
                                    <td>{{ row.count }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="light">{{ 'No forms yet.'|t('simple-form') }}</p>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
