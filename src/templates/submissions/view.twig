{% extends '_layouts/cp.twig' %}

{% set title = 'Submission #'|t('simple-form') ~ submission.id %}
{% set selectedSubnavItem = 'submissions' %}
{% do craft.app.view.registerAssetBundle('fabianhaef\\simpleform\\web\\assets\\cp\\SimpleFormCpAsset') %}

{% block content %}
<div class="buttons">
    <a href="{{ cpUrl('simple-form/submissions') }}" class="btn">{{ '← Back'|t('simple-form') }}</a>
    {% if form %}
        <a href="{{ cpUrl('simple-form/forms/edit/' ~ form.id) }}" class="btn">{{ 'Edit Form'|t('simple-form') }}</a>
    {% endif %}
    {% if pdfAvailable %}
        <a href="{{ cpUrl('simple-form/submissions/' ~ submission.id ~ '/pdf') }}" class="btn" data-icon="download">
            {{ 'Download PDF'|t('simple-form') }}
        </a>
    {% endif %}
    <button id="toggle-status-btn" class="btn secondary"
            data-action="{{ cpUrl('simple-form/submissions/toggle-status') }}"
            data-submission-id="{{ submission.id }}"
            data-error="{{ 'Couldn’t update the status.'|t('simple-form') }}">
        {{ 'Mark as {status}'|t('simple-form', { status: (submission.readStatus == 'new' ? 'Read'|t('simple-form') : (submission.readStatus == 'read' ? 'Archived'|t('simple-form') : 'New'|t('simple-form'))) }) }}
    </button>
</div>

<div class="submission-detail">
    <div class="detail-header">
        <div class="detail-info">
            <p>
                <strong>{{ 'Form:'|t('simple-form') }}</strong>
                <a href="{{ cpUrl('simple-form/submissions', {formId: form.id}) }}">
                    {{ form.title ?? form.name }}
                </a>
            </p>
            <p>
                <strong>{{ 'Status:'|t('simple-form') }}</strong>
                <span class="status {{ submission.readStatus }}">
                    {{ submission.readStatus|upper }}
                </span>
            </p>
            {% if workflowEnabled %}
                <p>
                    <strong>{{ 'Stage:'|t('simple-form') }}</strong>
                    {% if workflowStatus %}
                        <span class="status {{ workflowStatus.color }}"></span> {{ workflowStatus.label }}
                    {% else %}
                        <span class="light">{{ '—'|t('simple-form') }}</span>
                    {% endif %}
                </p>
                {% if workflowTransitions is not empty %}
                    <div class="sf-workflow-actions">
                        {% for transition in workflowTransitions %}
                            <form method="post" accept-charset="UTF-8" class="sf-inline-form">
                                {{ csrfInput() }}
                                <input type="hidden" name="action" value="simple-form/submissions/transition">
                                <input type="hidden" name="submissionId" value="{{ submission.id }}">
                                <input type="hidden" name="toStatus" value="{{ transition.to }}">
                                {{ redirectInput('simple-form/submissions/' ~ submission.id) }}
                                <button type="submit" class="btn">{{ transition.label }}</button>
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
            <p>
                <strong>{{ 'Date:'|t('simple-form') }}</strong>
                {{ submission.dateCreated|date('Y-m-d H:i:s') }}
            </p>
            {% if submission.quizScore is not null %}
                <p>
                    <strong>{{ 'Score:'|t('simple-form') }}</strong>
                    {{ submission.quizScore }}{% if submission.quizMaxScore %} / {{ submission.quizMaxScore }}{% endif %}
                    {% if submission.quizPercentage is not null %}
                        ({{ submission.quizPercentage }}%)
                    {% endif %}
                    {% if submission.quizGrade %}
                        <span class="status-label">{{ submission.quizGrade }}</span>
                    {% endif %}
                </p>
            {% endif %}
            {% if submission.attribution %}
                {% set attrLabels = {
                    utm_source: 'UTM Source'|t('simple-form'),
                    utm_medium: 'UTM Medium'|t('simple-form'),
                    utm_campaign: 'UTM Campaign'|t('simple-form'),
                    utm_term: 'UTM Term'|t('simple-form'),
                    utm_content: 'UTM Content'|t('simple-form'),
                    referrer: 'Referrer'|t('simple-form'),
                    landing_page: 'Landing page'|t('simple-form'),
                } %}
                <p><strong>{{ 'Attribution:'|t('simple-form') }}</strong></p>
                <dl class="sf-attribution">
                    {% for key, label in attrLabels %}
                        {% if submission.attribution[key] is defined %}
                            <dt>{{ label }}</dt>
                            <dd>{{ submission.attribution[key] }}</dd>
                        {% endif %}
                    {% endfor %}
                </dl>
            {% endif %}
            {% if submission.userId %}
                {% set user = craft.users.id(submission.userId).one() %}
                <p>
                    <strong>{{ 'User:'|t('simple-form') }}</strong>
                    {% if user %}
                        {{ user.fullName ?? user.username }}
                    {% else %}
                        {{ 'Unknown User'|t('simple-form') }}
                    {% endif %}
                </p>
            {% endif %}
            {% if submission.paymentStatus %}
                {% set paymentLabels = {
                    pending: 'Pending'|t('simple-form'),
                    paid: 'Paid'|t('simple-form'),
                    canceled: 'Canceled'|t('simple-form'),
                } %}
                <p>
                    <strong>{{ 'Payment:'|t('simple-form') }}</strong>
                    <span class="status-label status-{{ submission.paymentStatus }}">
                        {{ paymentLabels[submission.paymentStatus] ?? submission.paymentStatus|capitalize }}
                    </span>
                </p>
                {% if submission.paymentAmount %}
                    <p>
                        <strong>{{ 'Amount:'|t('simple-form') }}</strong>
                        {{ submission.paymentAmount|number_format(2) }}
                    </p>
                {% endif %}
                {% if submission.couponCode %}
                    <p>
                        <strong>{{ 'Coupon:'|t('simple-form') }}</strong>
                        <code>{{ submission.couponCode }}</code>
                        {% if submission.discountAmount %}
                            <span class="light">(−{{ submission.discountAmount|number_format(2) }})</span>
                        {% endif %}
                    </p>
                {% endif %}
                {% if submission.orderId %}
                    <p>
                        <strong>{{ 'Order:'|t('simple-form') }}</strong>
                        {% if craft.app.plugins.isPluginInstalled('commerce') %}
                            <a href="{{ cpUrl('commerce/orders/' ~ submission.orderId) }}">
                                #{{ submission.orderId }}
                            </a>
                        {% else %}
                            #{{ submission.orderId }}
                        {% endif %}
                    </p>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <hr>

    <h3>{{ 'Submission Data'|t('simple-form') }}</h3>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Field'|t('simple-form') }}</th>
                <th>{{ 'Value'|t('simple-form') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for fieldKey, fieldData in data %}
                <tr>
                    <td>{{ fieldData.label ?? fieldKey }}</td>
                    <td>
                        {% if fieldData.type == 'consent' %}
                            {% set consent = fieldData.value %}
                            {% if consent.consented %}
                                {{ 'Consented: Yes'|t('simple-form') }}
                                {%- if consent.consentedAt %} — {{ consent.consentedAt|date('Y-m-d H:i') }}{% endif %}
                                {%- if consent.textVersion %}<br><small class="light">{{ 'Text:'|t('simple-form') }} {{ consent.textVersion }}</small>{% endif %}
                            {% else %}
                                {{ 'Consented: No'|t('simple-form') }}
                            {% endif %}
                        {% elseif fieldData.type == 'file' %}
                            {% for assetId in fieldData.value %}
                                {% set asset = craft.assets().id(assetId).one() %}
                                {% if asset %}
                                    <a href="{{ asset.url }}" target="_blank" rel="noopener">{{ asset.filename }}</a>{% if not loop.last %}<br>{% endif %}
                                {% endif %}
                            {% else %}
                                —
                            {% endfor %}
                        {% elseif fieldData.type == 'signature' %}
                            {% for assetId in fieldData.value %}
                                {% set asset = craft.assets().id(assetId).one() %}
                                {% if asset %}
                                    <a href="{{ asset.url }}" target="_blank" rel="noopener" class="simple-form-signature-asset">
                                        <img src="{{ asset.url }}" alt="{{ 'Signature'|t('simple-form') }}" style="max-width:240px;max-height:120px;border:1px solid var(--hairline-color);background:#fff;">
                                    </a>{% if not loop.last %}<br>{% endif %}
                                {% endif %}
                            {% else %}
                                {{ 'Signature scrubbed'|t('simple-form') }}
                            {% endfor %}
                        {% elseif fieldData.type in ['entry', 'category', 'tag', 'user', 'asset'] %}
                            {# Relation fields store live element ids: resolve each to its
                               title and link to the element's edit screen, surviving
                               disabled/other-site elements (status null, all sites) and
                               falling back gracefully when an element was deleted. #}
                            {% set relationIds = fieldData.value is iterable and fieldData.value is not string ? fieldData.value : (fieldData.value ? [fieldData.value] : []) %}
                            {% for relId in relationIds %}
                                {% set relElement = craft.app.elements.getElementById(relId, null, null, { siteId: '*', status: null }) %}
                                {% if relElement %}
                                    {% set relCpUrl = relElement.cpEditUrl ?? null %}
                                    {% if relCpUrl %}
                                        <a href="{{ relCpUrl }}">{{ relElement.title ?? relElement }}</a>
                                    {% else %}
                                        {{ relElement.title ?? relElement }}
                                    {% endif %}{% if not loop.last %}<br>{% endif %}
                                {% else %}
                                    <span class="light">{{ '(deleted #{id})'|t('simple-form', { id: relId }) }}</span>{% if not loop.last %}<br>{% endif %}
                                {% endif %}
                            {% else %}
                                —
                            {% endfor %}
                        {% elseif fieldData.display is defined %}
                            {{ fieldData.display }}
                        {% elseif fieldData.type == 'repeater' %}
                            {% set rows = fieldData.value is iterable ? fieldData.value : [] %}
                            {% if rows is empty %}
                                {{ 'No rows'|t('simple-form') }}
                            {% else %}
                                {# Column order = the inner handles seen across the rows. #}
                                {% set cols = [] %}
                                {% for row in rows %}
                                    {% for handle in row|keys %}
                                        {% if handle not in cols %}{% set cols = cols|merge([handle]) %}{% endif %}
                                    {% endfor %}
                                {% endfor %}
                                <table class="data">
                                    <thead>
                                        <tr>{% for handle in cols %}<th>{{ handle }}</th>{% endfor %}</tr>
                                    </thead>
                                    <tbody>
                                        {% for row in rows %}
                                            <tr>{% for handle in cols %}<td>{{ row[handle] ?? '—' }}</td>{% endfor %}</tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        {% elseif fieldData.value is iterable and fieldData.value is not string %}
                            {{ fieldData.value|join(', ') }}
                        {% else %}
                            {{ fieldData.value ?? '—' }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if integrationLogs is defined and integrationLogs %}
        <hr>
        <h3>{{ 'Integration Dispatches'|t('simple-form') }}</h3>

        {# Logs come newest-first, so the first row seen per integration is its
           latest dispatch. Warn if any integration's latest attempt failed. #}
        {% set latestStatus = {} %}
        {% for log in integrationLogs %}
            {% if latestStatus[log.integrationId] is not defined %}
                {% set latestStatus = latestStatus|merge({ (log.integrationId): log.status }) %}
            {% endif %}
        {% endfor %}
        {% if 'failed' in latestStatus|values %}
            <p class="sf-dispatch-warning">
                {{ 'The most recent dispatch failed for one or more integrations. Resend below to retry.'|t('simple-form') }}
            </p>
        {% endif %}

        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Integration'|t('simple-form') }}</th>
                    <th>{{ 'Status'|t('simple-form') }}</th>
                    <th>{{ 'Code'|t('simple-form') }}</th>
                    <th>{{ 'Attempt'|t('simple-form') }}</th>
                    <th>{{ 'When'|t('simple-form') }}</th>
                    <th>{{ 'Created'|t('simple-form') }}</th>
                    <th>{{ 'Message'|t('simple-form') }}</th>
                    {% if canManageIntegrations %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for log in integrationLogs %}
                    <tr>
                        <td>{{ integrationNames[log.integrationId] ?? ('#' ~ log.integrationId) }}</td>
                        <td><span class="status-label status-{{ log.status }}">{{ log.status|upper }}</span></td>
                        <td>{{ log.responseCode ?? '—' }}</td>
                        <td>{{ log.attempts }}</td>
                        <td>{{ log.dateCreated }}</td>
                        <td>
                            {%- set link = elementLinks[log.id] ?? null -%}
                            {%- if link -%}
                                <a href="{{ link.url }}">{{ link.label }}</a>
                            {%- else -%}
                                —
                            {%- endif -%}
                        </td>
                        <td class="sf-log-message{{ log.status == 'failed' ? ' is-error' : '' }}">{{ log.message ?: '—' }}</td>
                        {% if canManageIntegrations %}
                            <td class="thin">
                                <form method="post" style="display:inline" data-sf-confirm="{{ 'Resend this dispatch?'|t('simple-form') }}">
                                    {{ csrfInput() }}
                                    <input type="hidden" name="action" value="simple-form/integrations/resend">
                                    {{ redirectInput('simple-form/submissions/' ~ submission.id) }}
                                    <input type="hidden" name="integrationId" value="{{ log.integrationId }}">
                                    <input type="hidden" name="submissionId" value="{{ submission.id }}">
                                    <button type="submit" class="btn small">{{ 'Resend'|t('simple-form') }}</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>


{% endblock %}
