# Keep the distributed package lean: exclude dev-only paths from the
# Packagist/`composer install --prefer-dist` archive. Source installs are unaffected.
/tests              export-ignore
/scripts            export-ignore
/docs/cleanup       export-ignore
/docs/smoke-tests   export-ignore
/docs/testing       export-ignore
/docs/launch        export-ignore
/docs/optimize      export-ignore
/run-smoke-tests.sh export-ignore
/codeception.yml    export-ignore
/phpunit.xml        export-ignore
/phpstan.neon       export-ignore
/ecs.php            export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
